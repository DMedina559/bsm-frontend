{
  "name": "bsm-frontend",
  "description": "React interface for Bedrock Server Manager",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:run": "vitest run",
    "typecheck": "tsc --moduleResolution bundler --module esnext --noEmit --strict --skipLibCheck --lib es2022,dom tests/types/api-contract.ts tests/types/runtime-contract.ts && node ../scripts/check-api-calls.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.2",
    "json5": "^2.2.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.7",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.2",
    "recharts": "^3.10.1",
    "@bedrock-server-manager/api-client": "*",
    "@bedrock-server-manager/runtime": "*",
    "@bedrock-server-manager/storage": "*"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DMedina559/bsm-frontend.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DMedina559/bsm-frontend/issues"
  },
  "homepage": "https://bedrock-server-manager.readthedocs.io/en/latest/#",
  "author": "dmedina559",
  "keywords": [
    "minecraft",
    "bedrock",
    "server",
    "manager",
    "ui",
    "react",
    "vite"
  ]
}
