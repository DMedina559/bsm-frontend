{
  "name": "bsm-frontend",
  "description": "React interface for Bedrock Server Manager",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "api:generate": "node scripts/generate-contract.mjs",
    "api:check": "node scripts/generate-contract.mjs --check",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --lib es2022,dom src/api/contract-check.ts && node scripts/check-api-calls.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.90.0",
    "json5": "^2.2.3",
    "lucide-react": "^1.47.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "react-syntax-highlighter": "^16.1.1",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "minimatch": "^10.2.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dmedina559/bedrock-server-manager.git"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dmedina559/bedrock-server-manager/issues"
  },
  "homepage": "https://bedrock-server-manager.readthedocs.io/en/latest/#",
  "author": "dmedina559",
  "keywords": [
    "minecraft",
    "bedrock",
    "server",
    "manager",
    "ui",
    "react",
    "vite"
  ]
}
