{
  "name": "bsm-workspace",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build:packages && npm run build:web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint scripts eslint.config.js prettier.config.js && npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "api:check": "npm run api:check --workspace=@bedrock-server-manager/api-client",
    "api:generate": "npm run api:generate --workspace=@bedrock-server-manager/api-client",
    "test:packages": "node scripts/test-packages.mjs",
    "packages:check": "node scripts/check-packages.mjs",
    "prepare": "npm run build:packages",
    "build:packages": "npm run build --workspace=@bedrock-server-manager/api-client --workspace=@bedrock-server-manager/runtime --workspace=@bedrock-server-manager/storage",
    "build:web": "npm run build --workspace=bsm-frontend",
    "build:python": "npm run build && node scripts/build-python.mjs",
    "check": "npm run build:packages && npm run api:check && npm run lint && npm run typecheck && npm test && npm run packages:check",
    "dev": "npm run build:packages && npm run dev --workspace=bsm-frontend"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.10",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.2"
  }
}
